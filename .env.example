# Image Generation API Configuration
# Copy this file to .env and fill in your actual values

# The base URL for the image generation API (Optional - defaults to https://api.example.com)
# 图像生成 API 地址（可选 - 默认使用 https://api.example.com）
IMAGE_API_URL=https://your-api-url.com

# Your user authentication token (Required)
# 用户 OpenID（必填）
USER_OPENID=your-user-openid-here
